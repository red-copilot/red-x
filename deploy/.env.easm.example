POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
NEO4J_PASSWORD=replace-with-a-long-random-password

# Native ARL overrides. Source this file before running ./arl when using the
# optional EASM infrastructure. Systemd users can copy the same values into
# /etc/arl/arl.env instead.
ARL_NEO4J_URI=bolt://127.0.0.1:7687
ARL_NEO4J_USER=neo4j
ARL_NEO4J_PASSWORD=${NEO4J_PASSWORD}
ARL_ICP_ICPQUERY_BASE_URL=http://127.0.0.1:16181
# ARL_ICP_CHINAZ_COOKIE_FILE=/opt/arl/secrets/chinaz.cookie
# ARL_GEOIP_CITY=/opt/arl/geoip/dbip-city-lite.mmdb
# ARL_GEOIP_ASN=/opt/arl/geoip/dbip-asn-lite.mmdb

EASM_LIVE_DOMAIN=
EASM_LIVE_SCAN=0
