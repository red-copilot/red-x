# Optional overrides for /etc/arl/config.yaml. Keep this file mode 0640 and
# replace all placeholders before exposing ARL outside localhost.
# ARL_POSTGRES_DSN=postgres://arl:arlpassword@127.0.0.1:5432/arl?sslmode=disable
# ARL_REDIS_URL=redis://:arlpassword@127.0.0.1:6379/0
# ARL_AUTH_ACCESS_SECRET=replace-with-a-long-random-secret
# ARL_API_KEY_PEPPER=replace-with-a-random-pepper
# ARL_ADMIN_PASSWORD=replace-with-the-initial-admin-password
# ARL_COOKIE_SECURE=true
# ARL_NEO4J_URI=bolt://127.0.0.1:7687
# ARL_NEO4J_USER=neo4j
# ARL_NEO4J_PASSWORD=replace-with-neo4j-password
# ARL_ICP_ICPQUERY_BASE_URL=http://127.0.0.1:16181
# ARL_ICP_CHINAZ_COOKIE_FILE=/opt/arl/secrets/chinaz.cookie
# ARL_GEOIP_CITY=/opt/arl/geoip/dbip-city-lite.mmdb
# ARL_GEOIP_ASN=/opt/arl/geoip/dbip-asn-lite.mmdb
